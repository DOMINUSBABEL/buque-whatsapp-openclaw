# ==============================================================================
# BUQUE WHATSAPP OPENCLAW - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network & Host
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# WhatsApp Administrator Numbers (Separated by comma, E.164 without '+')
ADMIN_PHONE_NUMBERS=573001234567

# Google Maps / Places API Key (Optional: fallbacks to resilient headless parser if empty)
GOOGLE_MAPS_API_KEY=

# LLM & Generation Providers (Optional for enhanced copy phrasing)
GEMINI_API_KEY=
GROQ_API_KEY=

# Outreach Throttling
PACING_DELAY_MIN_SEC=45
PACING_DELAY_MAX_SEC=120
